{
  "expo": {
    "name": "EdnaCharge",
    "slug": "ednacharge",
    "version": "0.0.1",
    "scheme": "ednacharge",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ednacharge.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby chargers.",
        "NSCameraUsageDescription": "Take photos of your charger when you list it.",
        "NSPhotoLibraryUsageDescription": "Pick a charger photo from your library."
      }
    },
    "android": {
      "package": "com.ednacharge.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EdnaCharge to use your location to find nearby chargers."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
