{
  "expo": {
    "name": "EdnaCharge",
    "slug": "ednacharge",
    "version": "0.0.1",
    "scheme": "ednacharge",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ednacharge.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby chargers and route you to bookings.",
        "NSCameraUsageDescription": "EdnaCharge uses the camera to verify your identity (a photo of your ID and a selfie) for secure payments and charger access.",
        "NSPhotoLibraryUsageDescription": "EdnaCharge needs photo access so you can upload identity documents for verification.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.ednacharge.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EdnaCharge to use your location to find nearby chargers.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "owner": "divyanshkoolwal",
    "extra": {
      "eas": {
        "projectId": "d89941c0-17c0-48d4-8298-a7fd4a02a32d"
      }
    }
  }
}
