{
  "name": "@edna/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore='**/node_modules/**' src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@edna/config": "workspace:*",
    "@edna/db": "workspace:*",
    "@edna/server-utils": "workspace:*",
    "bullmq": "^5.20.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
