NODE_ENV=development

# Explicit opt-in for dev-bypass (Stripe pre-auth fakery + signed dev auth tokens).
# REQUIRED in dev to skip real Stripe / real Supabase auth. NEVER set in production.
ENABLE_DEV_BYPASS=1
# HMAC secret for the local dev auth token (min 16 chars). Dev/staging only.
AUTH_DEV_SECRET=

# Postgres (local Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis (local)
REDIS_URL=redis://localhost:6379

# Supabase (local — fill in after `supabase start`)
# Postgres, realtime channels, Storage, AND app authentication (the API verifies
# access tokens via SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_CONNECT=

# Sentry DSNs — leave blank to disable in local dev; sentry:smoke requires them
SENTRY_DSN_API=
SENTRY_DSN_CSMS=
SENTRY_DSN_WORKER=
SENTRY_DSN_MOBILE=

# Service ports
API_PORT=3000
CSMS_PORT=3100
WORKER_PORT=3200
API_URL=http://localhost:3000
CSMS_PUBLIC_URL=ws://localhost:3100
OCPP_SECRET_ENC_KEY=
OCPP_COMMAND_CONCURRENCY=8

# Review moderation admins (comma-separated emails)
MODERATION_ADMIN_EMAILS=

# PostHog / Mapbox
POSTHOG_KEY=
MAPBOX_TOKEN=

# Mobile (Expo public env — must be prefixed EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
