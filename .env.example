NODE_ENV=development

# Postgres (local Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis (local)
REDIS_URL=redis://localhost:6379

# Supabase (local — fill in after `supabase start`)
# Still used for local Postgres and realtime channels. App authentication is Firebase.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Auth (Google login)
# API: use either FIREBASE_SERVICE_ACCOUNT_JSON or the three split service account fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry DSNs — leave blank to disable in local dev; sentry:smoke requires them
SENTRY_DSN_API=
SENTRY_DSN_CSMS=
SENTRY_DSN_WORKER=
SENTRY_DSN_MOBILE=

# Service ports
API_PORT=3000
CSMS_PORT=3100
WORKER_PORT=3200

# PostHog / Mapbox
POSTHOG_KEY=
MAPBOX_TOKEN=

# Mobile (Expo public env — must be prefixed EXPO_PUBLIC_)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
