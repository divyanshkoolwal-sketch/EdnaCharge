{
  "name": "ednacharge",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "pnpm -F @edna/db generate",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:conventions && turbo run lint",
    "lint:conventions": "tsx scripts/check-source-conventions.ts",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh",
    "demo:loop": "tsx scripts/demo-loop.ts",
    "smoke:product": "pnpm -F @edna/api exec vitest run test/availability-readiness.unit.test.ts test/moderation.unit.test.ts test/refund-math.unit.test.ts test/account-deletion.unit.test.ts && pnpm -F @edna/mobile exec vitest run test/notificationRouting.unit.test.ts",
    "sentry:smoke": "tsx scripts/sentry-smoke.ts",
    "sim": "pnpm -F @edna/ocpp-simulator start --",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@sentry/cli",
      "msgpackr-extract",
      "protobufjs"
    ]
  }
}
