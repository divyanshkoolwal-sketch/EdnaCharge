{
  "name": "ednacharge",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "pnpm -F @edna/db generate",
    "prepare": "husky",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:conventions && pnpm lint:eslint && turbo run lint",
    "lint:conventions": "tsx scripts/check-source-conventions.ts",
    "lint:eslint": "eslint .",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh",
    "test:coverage": "turbo run test:coverage",
    "test:perf": "turbo run test:perf",
    "deadcode": "knip",
    "deps:unused": "knip --dependencies",
    "deps:check": "syncpack list-mismatches",
    "dupcheck": "jscpd",
    "depcruise": "depcruise apps/api apps/csms apps/worker packages",
    "size": "size-limit",
    "todos": "tsx scripts/scan-todos.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "docs:typedoc": "typedoc",
    "changeset": "changeset",
    "release": "changeset publish",
    "profile:api": "node --cpu-prof --cpu-prof-dir=.profiles --import tsx apps/api/src/index.ts",
    "profile:csms": "node --cpu-prof --cpu-prof-dir=.profiles --import tsx apps/csms/src/index.ts",
    "profile:worker": "node --cpu-prof --cpu-prof-dir=.profiles --import tsx apps/worker/src/index.ts",
    "profile:flame": "npx --yes clinic flame -- node --import tsx apps/api/src/index.ts",
    "demo:loop": "tsx scripts/demo-loop.ts",
    "smoke:product": "pnpm -F @edna/api exec vitest run test/availability-readiness.unit.test.ts test/moderation.unit.test.ts test/refund-math.unit.test.ts test/account-deletion.unit.test.ts && pnpm -F @edna/mobile exec vitest run test/notificationRouting.unit.test.ts",
    "sentry:smoke": "tsx scripts/sentry-smoke.ts",
    "sim": "pnpm -F @edna/ocpp-simulator start --",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.9.0",
    "@size-limit/file": "^11.1.6",
    "@types/node": "^20.12.12",
    "@vitest/coverage-v8": "^2.0.5",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "jscpd": "^4.0.5",
    "knip": "^5.30.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "size-limit": "^11.1.6",
    "syncpack": "^13.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typedoc": "^0.26.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.6.0",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@sentry/cli",
      "msgpackr-extract",
      "protobufjs"
    ]
  }
}
